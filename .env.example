# Public frontend configuration. This URL is safe to expose in the browser.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Backend-only runtime configuration. Values below are safe placeholders only.
TRAFRIEND_ENV=development
TRAFRIEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Overnight provider selection. Mock remains the local/CI default.
TRAFRIEND_OVERNIGHT_PROVIDER=mock

# Alpaca is optional and backend-only. Never prefix these with NEXT_PUBLIC_.
ALPACA_API_KEY=replace_with_backend_only_key_id
ALPACA_SECRET_KEY=replace_with_backend_only_secret_key
TRAFRIEND_ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Free-plan defaults: real-time indicative quote midpoint, delayed BOATS bars.
TRAFRIEND_ALPACA_SNAPSHOT_FEED=overnight
TRAFRIEND_ALPACA_SNAPSHOT_QUALITY=REALTIME
TRAFRIEND_ALPACA_BARS_FEED=boats
TRAFRIEND_ALPACA_BARS_QUALITY=DELAYED
